import random

GOAL_KEYS = 3
TOTAL_JARS = 5
MAX_HEARTS = 3

def ask_level() -> int:
    """Demande un niveau de difficulté valide entre 1 et 3."""
    print("Bienvenue dans Magic Jars !")
    print("Choisis ton niveau : 1 (facile), 2 (moyen), 3 (difficile)")

    while True:
        user_input = input("Niveau > ").strip()
        if user_input in {"1", "2", "3"}:
            return int(user_input)
        print("Entrée invalide. Merci d'écrire 1, 2 ou 3.")


def ask_jar_choice() -> int:
    """Demande au joueur une jarre valide entre 1 et 5."""
    while True:
        user_input = input("Choisis une jarre (1-5) > ").strip()
        if user_input in {"1", "2", "3", "4", "5"}:
            return int(user_input)
        print("Choix invalide. Tu dois entrer un nombre entre 1 et 5.")


def build_jars(level: int) -> list[str]:
    """Construit la liste des jarres selon le niveau (S = serpent, K = clé)."""
    snakes = ["S"] * level
    keys = ["K"] * (TOTAL_JARS - level)
    jars = snakes + keys
    random.shuffle(jars)
    return jars


def play_game() -> None:
    level = ask_level()
    keys_collected = 0
    hearts = MAX_HEARTS
    streak = 0
    round_number = 1

    print(
        f"\nObjectif: récupérer {GOAL_KEYS} clés magiques avant de perdre tes {MAX_HEARTS} cœurs."
    )
    print("Règle bonus: 2 victoires d'affilée = +1 clé bonus !\n")

    while keys_collected < GOAL_KEYS and hearts > 0:
        print(f"--- Manche {round_number} ---")
        print(f"État: {keys_collected}/{GOAL_KEYS} clés | {hearts}/{MAX_HEARTS} cœurs")

        jars = build_jars(level)
        choice = ask_jar_choice()

        selected = jars[choice - 1]
        print(f"Tu as choisi la jarre n°{choice}.")

        if selected == "K":
            keys_collected += 1
            streak += 1
            print("✅ Bonne pioche ! Tu obtiens une clé magique.")

            if streak == 2 and keys_collected < GOAL_KEYS:
                keys_collected += 1
                streak = 0
                print("✨ Combo ! 2 réussites de suite: +1 clé bonus.")
        else:
            hearts -= 1
            streak = 0
            print("🐍 Oh non ! Un serpent apparaît. Tu perds 1 cœur.")

        print(f"Contenu des jarres (debug/fin de manche): {jars}\n")
        round_number += 1

    if keys_collected >= GOAL_KEYS:
        print("🏆 Victoire ! Tu deviens le roi du temple !")
    else:
        print("💀 Défaite... Le temple se referme sur toi.")


if __name__ == "__main__":
    play_game()
